set_property IOSTANDARD LVCMOS33 [get_ports {led_dbg[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led_dbg[0]}]

# 7-Segment Anodes
set_property PACKAGE_PIN G4 [get_ports {seg_an[3]}]
set_property PACKAGE_PIN G5 [get_ports {seg_an[2]}]
set_property PACKAGE_PIN E1 [get_ports {seg_an[1]}]
