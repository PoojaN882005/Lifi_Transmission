# Clock
set_property PACKAGE_PIN N11 [get_ports clk]
set_property IOSTANDARD LVCMOS33 [get_ports clk]

# LDR Analog Inputs
set_property PACKAGE_PIN E2 [get_ports vauxp15]
set_property IOSTANDARD LVCMOS33 [get_ports vauxp15]
set_property PACKAGE_PIN D1 [get_ports vauxn15]
set_property IOSTANDARD LVCMOS33 [get_ports vauxn15]

# Buzzer
set_property PACKAGE_PIN K12 [get_ports buzzer]
set_property IOSTANDARD LVCMOS33 [get_ports buzzer]

# Status LEDs
set_property PACKAGE_PIN J3 [get_ports led_mode]
set_property IOSTANDARD LVCMOS33 [get_ports led_mode]

set_property PACKAGE_PIN L3 [get_ports {led_dbg[3]}]
